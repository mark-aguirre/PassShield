{
  "name": "PassShield",
  "version": "0.1.0",
  "private": true,
  "description": "PassShield - a local-first, cross-platform desktop password manager",
  "author": "PassShield",
  "license": "UNLICENSED",
  "main": "apps/desktop/dist/main/main.js",
  "workspaces": [
    "packages/*",
    "apps/desktop/renderer",
    "apps/desktop"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "build": "tsc --build",
    "build:renderer": "npm run build --workspace @PassShield/renderer",
    "build:main": "npm run build --workspace @PassShield/desktop",
    "dev:renderer": "npm run dev --workspace @PassShield/renderer",
    "dev": "npm run dev --workspace @PassShield/desktop",
    "start": "npm run start --workspace @PassShield/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
