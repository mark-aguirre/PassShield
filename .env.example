# PassShield environment configuration (example).
#
# Copy this file to .env (or .env.local) and adjust as needed. Both .env and
# .env.local are git-ignored. run.sh loads .env then .env.local on startup;
# values already set in your shell environment take precedence over these files.

# Preferred port for the Next.js renderer dev server used by ./run.sh in dev
# mode. If this port is busy, run.sh scans upward for the next free port and
# points Electron at the same URL, so the renderer and Electron never drift
# apart. Default: 3000.
RENDERER_PORT=3000
